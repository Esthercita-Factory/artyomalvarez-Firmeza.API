# Configuración de Entorno para Firmeza API en Producción / Docker Compose
# COPIAR este archivo como .env y rellenar con credenciales seguras (nunca subir .env al repositorio)

# Clave secreta para firma de tokens JWT (Mínimo 32 caracteres)
JWT_KEY=TuClaveSuperSeguraMinimo32Caracteres2026!

# Emisor y Audiencia del token
JWT_ISSUER=FirmezaApi
JWT_AUDIENCE=FirmezaClient

# Cadena de conexión a PostgreSQL (Supabase o Postgres local)
DATABASE_URL=Host=tu-host.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=tu_contraseña_secreta;SSL Mode=Require;Trust Server Certificate=true

# Origen permitido para CORS (ej. frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Credenciales para inicialización del usuario Administrador (opcional)
ADMIN_EMAIL=admin@firmeza.com
ADMIN_PASSWORD=ContraseñaSuperFuerte123!
